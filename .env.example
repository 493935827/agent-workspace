# ============================================================
# agent-workspace secret schema
# Copy this file to .env and fill in real values.
#
# RULES:
#   - .env is gitignored and NEVER enters git or offline bundles.
#   - `agentctl doctor` only reports SET / MISSING, never values.
#   - Keep this file in sync when you add new secret names.
# ============================================================

# --- common (all environments) ---
LOCAL_LLM_URL=

# --- personal ---
OPENAI_API_KEY=
STEAM_API_KEY=

# --- company ---
COMPANY_TOKEN=

# --- intranet ---
INTERNAL_DOC_URL=